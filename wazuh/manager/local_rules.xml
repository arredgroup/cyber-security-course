<!-- ==========================================================================
     Reglas personalizadas del curso para validar las detecciones del deck.
     Colocar en el MANAGER:  /var/ossec/etc/rules/local_rules.xml

     Instalación correcta (con permisos y PRUEBA antes de reiniciar):
       docker cp local_rules.xml wazuh.manager:/var/ossec/etc/rules/local_rules.xml
       docker exec wazuh.manager chown wazuh:wazuh /var/ossec/etc/rules/local_rules.xml
       docker exec wazuh.manager /var/ossec/bin/wazuh-analysisd -t   (prueba la sintaxis)
       docker exec wazuh.manager /var/ossec/bin/wazuh-control restart

     Patrón: una regla BASE que matchea el evento + una regla de FRECUENCIA que
     referencia a la base con <if_matched_sid> (así se hace la correlación).
     Los IDs 100100+ son locales. Si tu versión de Wazuh no reconoce algún ID
     MITRE, quita ese bloque <mitre> (puede impedir la carga de las reglas).
     ========================================================================== -->
<group name="windows,local,curso,">

  <!-- ===== Fuerza bruta (4625) ===== -->
  <!-- Base: un inicio de sesión fallido -->
  <rule id="100100" level="5">
    <field name="win.system.eventID">^4625$</field>
    <description>Windows: inicio de sesión fallido (4625)</description>
    <mitre><id>T1110</id></mitre>
  </rule>

  <!-- Correlación: varios 4625 desde la misma IP en poco tiempo -->
  <rule id="100110" level="10" frequency="8" timeframe="120">
    <if_matched_sid>100100</if_matched_sid>
    <same_field>win.eventdata.ipAddress</same_field>
    <description>Windows: posible fuerza bruta (múltiples 4625 desde la misma IP)</description>
    <mitre><id>T1110</id></mitre>
  </rule>

  <!-- ===== Creación de cuentas / escalamiento ===== -->
  <rule id="100101" level="8">
    <field name="win.system.eventID">^4720$</field>
    <description>Windows: se creó una cuenta de usuario (4720)</description>
    <mitre><id>T1136</id></mitre>
  </rule>

  <!-- Miembro agregado a un grupo local (4732) -->
  <rule id="100102" level="6">
    <field name="win.system.eventID">^4732$</field>
    <description>Windows: miembro agregado a un grupo local (4732)</description>
    <mitre><id>T1098</id></mitre>
  </rule>

  <!-- Si el grupo es Administradores, subir la severidad -->
  <rule id="100103" level="12">
    <if_sid>100102</if_sid>
    <field name="win.eventdata.targetUserName">Administr</field>
    <description>Windows: cuenta agregada al grupo Administradores (escalamiento/persistencia)</description>
    <mitre><id>T1098</id></mitre>
  </rule>

  <!-- ===== Anti-forense: borrado del log de seguridad (1102) ===== -->
  <rule id="100104" level="12">
    <field name="win.system.eventID">^1102$</field>
    <description>Windows: se borró el registro de seguridad (anti-forense)</description>
    <mitre><id>T1070</id></mitre>
  </rule>

  <!-- ===== Acceso a LSASS vía Sysmon (Event ID 10) ===== -->
  <rule id="100105" level="12">
    <field name="win.system.eventID">^10$</field>
    <field name="win.eventdata.targetImage">lsass.exe$</field>
    <description>Sysmon: acceso a la memoria de LSASS (posible volcado de credenciales)</description>
    <mitre><id>T1003</id></mitre>
  </rule>

  <!-- ===== Apertura de puerto: nueva regla de firewall de entrada (2004) ===== -->
  <rule id="100106" level="6">
    <field name="win.system.eventID">^2004$</field>
    <description>Windows Firewall: se agregó una regla de entrada (apertura de puerto)</description>
    <mitre><id>T1562</id></mitre>
  </rule>

  <!-- ===== Instalación de software (MsiInstaller 1033) ===== -->
  <rule id="100107" level="4">
    <field name="win.system.eventID">^1033$</field>
    <description>Windows: instalación de software (MsiInstaller 1033)</description>
  </rule>

</group>
