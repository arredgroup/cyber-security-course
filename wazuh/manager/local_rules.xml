<!-- ==========================================================================
     Reglas personalizadas del curso para validar las detecciones del deck.
     Colocar en el MANAGER:  /var/ossec/etc/rules/local_rules.xml
     (en Docker:  docker cp local_rules.xml wazuh.manager:/var/ossec/etc/rules/ )
     Reiniciar el manager:  docker exec wazuh.manager /var/ossec/bin/wazuh-control restart

     Nota: los nombres de campo (win.system.eventID, win.eventdata.*) y los
     niveles pueden requerir pequeños ajustes según la versión de Wazuh.
     Los IDs 100100+ son locales (rango libre para reglas propias).
     ========================================================================== -->
<group name="windows,local,curso,">

  <!-- Fuerza bruta: muchos 4625 desde la misma IP en poco tiempo (T1110) -->
  <rule id="100100" level="10" frequency="8" timeframe="60">
    <if_group>windows_security</if_group>
    <field name="win.system.eventID">^4625$</field>
    <same_field>win.eventdata.ipAddress</same_field>
    <description>Posible fuerza bruta a Windows: múltiples 4625 desde la misma IP</description>
    <mitre><id>T1110</id></mitre>
  </rule>

  <!-- Cuenta agregada al grupo Administradores (4732) -->
  <rule id="100101" level="12">
    <if_group>windows_security</if_group>
    <field name="win.system.eventID">^4732$</field>
    <field name="win.eventdata.targetUserName">Administr</field>
    <description>Cuenta agregada a Administradores (posible persistencia/escalamiento)</description>
    <mitre><id>T1098</id></mitre>
  </rule>

  <!-- Cuenta de usuario creada (4720) -->
  <rule id="100102" level="8">
    <if_group>windows_security</if_group>
    <field name="win.system.eventID">^4720$</field>
    <description>Se creó una cuenta de usuario en Windows</description>
    <mitre><id>T1136.001</id></mitre>
  </rule>

  <!-- Borrado del registro de seguridad (1102) - anti-forense -->
  <rule id="100103" level="12">
    <field name="win.system.eventID">^1102$</field>
    <description>Se borró el registro de seguridad de Windows (anti-forense)</description>
    <mitre><id>T1070.001</id></mitre>
  </rule>

  <!-- Acceso a LSASS vía Sysmon (Event ID 10) - volcado de credenciales -->
  <rule id="100104" level="12">
    <field name="win.system.eventID">^10$</field>
    <field name="win.eventdata.targetImage">lsass.exe$</field>
    <description>Acceso a la memoria de LSASS (posible volcado de credenciales)</description>
    <mitre><id>T1003.001</id></mitre>
  </rule>

  <!-- Nueva regla de firewall de entrada (Event ID 2004) -->
  <rule id="100105" level="8">
    <field name="win.system.eventID">^2004$</field>
    <description>Se agregó una regla de firewall de entrada (apertura de puerto)</description>
    <mitre><id>T1562.004</id></mitre>
  </rule>

  <!-- Instalación de software vía MsiInstaller (Event ID 1033) -->
  <rule id="100106" level="5">
    <field name="win.system.eventID">^1033$</field>
    <description>Instalación de software detectada (MsiInstaller)</description>
    <mitre><id>T1072</id></mitre>
  </rule>

</group>
