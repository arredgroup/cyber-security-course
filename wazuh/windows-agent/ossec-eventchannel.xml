<!-- ==========================================================================
     Pegar estos bloques DENTRO de <ossec_config> en el ossec.conf del AGENTE
     Windows (C:\Program Files (x86)\ossec-agent\ossec.conf), y reiniciar el
     servicio:  Restart-Service WazuhSvc
     Esto hace que el agente reenvíe los canales de eventos de Windows al manager.
     ========================================================================== -->

<localfile>
  <location>Security</location>
  <log_format>eventchannel</log_format>
</localfile>

<localfile>
  <location>System</location>
  <log_format>eventchannel</log_format>
</localfile>

<localfile>
  <location>Application</location>
  <log_format>eventchannel</log_format>
</localfile>

<!-- Requiere Sysmon instalado (ver install-sysmon.ps1) -->
<localfile>
  <location>Microsoft-Windows-Sysmon/Operational</location>
  <log_format>eventchannel</log_format>
</localfile>

<!-- Requiere Script Block Logging activado (Event ID 4104) -->
<localfile>
  <location>Microsoft-Windows-PowerShell/Operational</location>
  <log_format>eventchannel</log_format>
</localfile>

<!-- Cambios de reglas de firewall (Event ID 2004/2006) -->
<localfile>
  <location>Microsoft-Windows-Windows Firewall With Advanced Security/Firewall</location>
  <log_format>eventchannel</log_format>
</localfile>
